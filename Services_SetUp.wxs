<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!--
    Instalador de AeroManager.
    Compilar la solución en Release y después, desde esta carpeta:
      MSBuild Services_SetUp.wixproj /p:Configuration=Release
    El .msi queda en Instalador\bin.
  -->

  <?ifndef BinDir?>
    <?define BinDir="GUI_23DB\bin\Release"?>
  <?endif?>

  <!-- Subir Version en CADA entrega: MSI solo compara los tres primeros números, y con la
       misma versión no reemplaza la instalación anterior sino que quedan dos conviviendo. -->
  <Product Id="*"
           Name="AeroManager"
           Language="1033"
           Codepage="1252"
           Version="1.0.1"
           Manufacturer="UAI"
           UpgradeCode="78D1D09A-C777-43B1-81A5-9D81DD2AC281">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Instalador de AeroManager"
             Manufacturer="UAI" />

    <MajorUpgrade DowngradeErrorMessage="Ya hay instalada una versión más nueva de [ProductName]." />

    <Media Id="1" Cabinet="AeroManager.cab" EmbedCab="yes" />

    <!-- ==================== Requisito: .NET Framework 4.7.2 ==================== -->
    <!--
      NETFRAMEWORK45 (WixNetFxExtension) trae el valor Release de
      HKLM\SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full con formato "#nnnnnn".
      461808 es la clave del 4.7.2; con >= se aceptan las versiones posteriores.
      "Installed OR" deja reparar y desinstalar aunque el runtime ya no esté.
    -->
    <PropertyRef Id="NETFRAMEWORK45" />
    <Condition Message="AeroManager requiere Microsoft .NET Framework 4.7.2 o una versión posterior, y no se encontró en este equipo. Instálelo desde el sitio de Microsoft y vuelva a ejecutar este instalador.">
      <![CDATA[Installed OR (NETFRAMEWORK45 AND NETFRAMEWORK45 >= "#461808")]]>
    </Condition>

    <!-- Servidor SQL: toma el valor ya configurado, en la vista de 32 bits que es donde lo
         guarda este paquete y donde lo lee Conexion_23DB. Si no existe, queda ".". -->
    <Property Id="SQLSERVERNAME" Value="." Secure="yes">
      <RegistrySearch Id="BuscarServidorSql" Root="HKLM" Key="SOFTWARE\AeroManager" Name="Server" Type="raw" Win64="no" />
    </Property>

    <!-- Las completa ValidarServidorSql: ruta de sqlcmd y carpeta temporal del usuario -->
    <Property Id="SQLCMDEXE" Secure="yes" />
    <Property Id="SQLLOGDIR" Secure="yes" />

    <Binary Id="InstaladorCA" SourceFile="$(var.CaDll)" />

    <Icon Id="GuiIcon.exe" SourceFile="$(var.BinDir)\GUI_23DB.exe" />
    <Property Id="ARPPRODUCTICON" Value="GuiIcon.exe" />

    <!-- ==================== Estructura de directorios ==================== -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="AeroManager">
          <Directory Id="IDIOMASFOLDER" Name="Idiomas" />
          <!-- Lo completa heat (AyudaComponents); la aplicación busca Ayuda junto al ejecutable -->
          <Directory Id="AYUDAFOLDER" Name="Ayuda" />
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="AeroManager" />
      </Directory>

      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- ==================== Archivos de la aplicación ==================== -->
    <ComponentGroup Id="ProductComponents">

      <!-- Ejecutable principal: incluye los accesos directos de escritorio y menú inicio -->
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
        <File Id="GUI_23DB.exe" Name="GUI_23DB.exe" Source="$(var.BinDir)\GUI_23DB.exe" KeyPath="yes" />
      </Component>

      <Component Id="CompGuiConfig" Directory="INSTALLFOLDER" Guid="*">
        <File Id="GUI_23DB.exe.config" Name="GUI_23DB.exe.config" Source="$(var.BinDir)\GUI_23DB.exe.config" KeyPath="yes" />
      </Component>

      <Component Id="CompBEDll" Directory="INSTALLFOLDER" Guid="*">
        <File Id="BE_23DB.dll" Name="BE_23DB.dll" Source="$(var.BinDir)\BE_23DB.dll" KeyPath="yes" />
      </Component>

      <Component Id="CompBLLDll" Directory="INSTALLFOLDER" Guid="*">
        <File Id="BLL_23DB.dll" Name="BLL_23DB.dll" Source="$(var.BinDir)\BLL_23DB.dll" KeyPath="yes" />
      </Component>

      <Component Id="CompBouncyCastle" Directory="INSTALLFOLDER" Guid="*">
        <File Id="BouncyCastle.Crypto.dll" Name="BouncyCastle.Crypto.dll" Source="$(var.BinDir)\BouncyCastle.Crypto.dll" KeyPath="yes" />
      </Component>

      <Component Id="CompDALDll" Directory="INSTALLFOLDER" Guid="*">
        <File Id="DAL_23DB.dll" Name="DAL_23DB.dll" Source="$(var.BinDir)\DAL_23DB.dll" KeyPath="yes" />
      </Component>

      <!-- Mappers de vuelos y mantenimiento: BLL_23DB depende de esta DLL -->
      <Component Id="CompMapperDll" Directory="INSTALLFOLDER" Guid="*">
        <File Id="Mapper_23DB.dll" Name="Mapper_23DB.dll" Source="$(var.BinDir)\Mapper_23DB.dll" KeyPath="yes" />
      </Component>

      <Component Id="CompItextsharpDll" Directory="INSTALLFOLDER" Guid="*">
        <File Id="itextsharp.dll" Name="itextsharp.dll" Source="$(var.BinDir)\itextsharp.dll" KeyPath="yes" />
      </Component>

      <Component Id="CompNewtonsoftDll" Directory="INSTALLFOLDER" Guid="*">
        <File Id="Newtonsoft.Json.dll" Name="Newtonsoft.Json.dll" Source="$(var.BinDir)\Newtonsoft.Json.dll" KeyPath="yes" />
      </Component>

      <Component Id="CompServicesDll" Directory="INSTALLFOLDER" Guid="*">
        <File Id="Services_23DB.dll" Name="Services_23DB.dll" Source="$(var.BinDir)\Services_23DB.dll" KeyPath="yes" />
      </Component>

      <!-- Script SQL, se copia junto al resto para poder ejecutarlo con sqlcmd -->
      <Component Id="CompSqlScript" Directory="INSTALLFOLDER" Guid="*">
        <File Id="TD_62FD.sql" Name="TD_62FD.sql" Source="TD_62FD.sql" KeyPath="yes" />
      </Component>

      <!-- Carpeta Idiomas con los tres JSON -->
      <Component Id="CompIdiomaEspanol" Directory="IDIOMASFOLDER" Guid="*">
        <File Id="Idioma_espanol_json" Name="español.json" Source="$(var.BinDir)\Idiomas\español.json" KeyPath="yes" />
      </Component>

      <Component Id="CompIdiomaIngles" Directory="IDIOMASFOLDER" Guid="*">
        <File Id="Idioma_ingles_json" Name="ingles.json" Source="$(var.BinDir)\Idiomas\ingles.json" KeyPath="yes" />
      </Component>

      <Component Id="CompIdiomaPortugues" Directory="IDIOMASFOLDER" Guid="*">
        <File Id="Idioma_portugues_json" Name="portugues.json" Source="$(var.BinDir)\Idiomas\portugues.json" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- ==================== Accesos directos ==================== -->
    <ComponentGroup Id="ShortcutComponents">

      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
        <Shortcut Id="DesktopShortcut"
                  Name="AeroManager"
                  Description="Iniciar AeroManager"
                  Target="[#GUI_23DB.exe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveDesktopFolder" Directory="DesktopFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\UAI\AeroManager" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="AeroManager"
                  Description="Iniciar AeroManager"
                  Target="[#GUI_23DB.exe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\UAI\AeroManager" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- ==================== Registro de Windows ==================== -->
    <ComponentGroup Id="RegistryComponents">

      <!--
        Guarda el servidor SQL ingresado por el usuario en HKLM\SOFTWARE\AeroManager\Server.
        El paquete no declara Platform="x64" (Package sin atributo Platform => x86 por
        defecto en WiX 3.11), así que este componente corre como proceso de 32 bits.
        En un SO de 64 bits, WOW64 redirige automáticamente cualquier escritura de un
        proceso de 32 bits en HKLM\SOFTWARE\AeroManager hacia
        HKLM\SOFTWARE\WOW6432Node\AeroManager; no hace falta declarar la ruta
        WOW6432Node de forma explícita porque el sistema operativo ya resuelve esa
        redirección de forma transparente para este componente. Declarar además un
        componente separado con Key="SOFTWARE\WOW6432Node\AeroManager" apuntaría en un
        SO de 64 bits a la misma ubicación física que este componente (WOW64 no
        redirige una ruta que ya empieza con "WOW6432Node"), lo que generaría dos
        componentes escribiendo la misma clave de registro -> se descartó por conflicto.
      -->
      <Component Id="CompRegistryServer" Directory="INSTALLFOLDER" Guid="*">
        <RegistryValue Root="HKLM" Key="SOFTWARE\AeroManager" Name="Server" Type="string" Value="[SQLSERVERNAME]" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <Feature Id="MainFeature" Title="AeroManager" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <ComponentGroupRef Id="RegistryComponents" />
      <ComponentGroupRef Id="AyudaComponents" />
    </Feature>

    <!-- ==================== Validación del servidor SQL ==================== -->
    <!--
      ValidarServidorSql busca sqlcmd y prueba la conexión con seguridad integrada. Corre al
      presionar Siguiente en SqlServerDlg, antes de copiar nada, y otra vez al comienzo de la
      ejecución para cubrir la instalación silenciosa, que no pasa por el asistente. Si algo
      falla deja el motivo en SQLCHECK_MSG y SQLCHECK_OK vacío.
    -->
    <CustomAction Id="ValidarServidorSql"
                  BinaryKey="InstaladorCA"
                  DllEntry="ValidarServidorSql"
                  Execute="immediate"
                  Return="check" />

    <CustomAction Id="CancelarSinSql" Error="[SQLCHECK_MSG]" />

    <!-- ==================== Ejecución del script SQL con sqlcmd ==================== -->
    <!--
      Patrón para CustomAction diferidas: la acción inmediata SetRunSqlScript arma el comando
      con las propiedades ya resueltas, y la diferida lo toma con ExeCommand="[RunSqlScriptCmd]".

      Impersonate="yes": corre con el usuario que instala, no con LocalSystem, porque sqlcmd
      se autentica con seguridad integrada y ese usuario es el que tiene permiso para crear
      la base.

      Parámetros de sqlcmd:
        -E  seguridad integrada.
        -C  confía en el certificado del servidor: la versión 18 cifra por defecto y falla
            con certificados autofirmados. Las versiones anteriores también lo aceptan.
        -I  QUOTED_IDENTIFIER en ON, que sqlcmd deja en OFF por defecto.
        -b  devuelve error si falla un lote: Return="check" cancela la instalación.
        -o  el registro va a la carpeta temporal del usuario, no a Program Files.

      Condición NOT Installed: también corre al actualizar desde una versión anterior, y eso
      es correcto porque TD_62FD.sql se puede ejecutar varias veces sin pisar los datos.
    -->
    <CustomAction Id="SetRunSqlScript"
                  Property="RunSqlScriptCmd"
                  Value="cmd.exe /c &quot;&quot;[SQLCMDEXE]&quot; -S &quot;[SQLSERVERNAME]&quot; -E -C -I -b -i &quot;[#TD_62FD.sql]&quot; -o &quot;[SQLLOGDIR]AeroManager_sqlcmd_install.log&quot; 2&gt;&amp;1&quot;"
                  Execute="immediate" />

    <CustomAction Id="RunSqlScript"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[RunSqlScriptCmd]"
                  Execute="deferred"
                  Return="check"
                  Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="ValidarServidorSql" Before="InstallInitialize">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="CancelarSinSql" After="ValidarServidorSql"><![CDATA[NOT Installed AND NOT REMOVE AND SQLCHECK_OK<>"1"]]></Custom>
      <Custom Action="SetRunSqlScript" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="RunSqlScript" After="SetRunSqlScript">NOT Installed</Custom>
    </InstallExecuteSequence>

    <!-- ==================== Interfaz de usuario ==================== -->
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <UI>
      <!-- Dialogo personalizado para ingresar el nombre del servidor SQL -->
      <Dialog Id="SqlServerDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                  Text="Configuración de la base de datos" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                  Text="Ingrese el nombre del servidor SQL donde se creará la base de datos." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="ServerLabel" Type="Text" X="20" Y="60" Width="150" Height="15"
                  Text="Servidor SQL:" />
        <Control Id="ServerEdit" Type="Edit" X="20" Y="75" Width="220" Height="18"
                  Property="SQLSERVERNAME" Text="{80}" />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&lt; Atrás" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Siguiente &gt;">
          <Condition Action="disable"><![CDATA[SQLSERVERNAME=""]]></Condition>
          <Condition Action="enable"><![CDATA[SQLSERVERNAME<>""]]></Condition>
          <Publish Event="DoAction" Value="ValidarServidorSql" Order="1">1</Publish>
          <Publish Event="SpawnDialog" Value="SqlErrorDlg" Order="2"><![CDATA[SQLCHECK_OK<>"1"]]></Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3"><![CDATA[SQLCHECK_OK="1"]]></Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancelar">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!-- Muestra por qué no se puede avanzar: sqlcmd ausente o instancia que no responde -->
      <Dialog Id="SqlErrorDlg" Width="300" Height="150" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Mensaje" Type="Text" X="15" Y="15" Width="270" Height="100" NoPrefix="yes"
                  Text="[SQLCHECK_MSG]" />
        <Control Id="Aceptar" Type="PushButton" X="122" Y="122" Width="56" Height="17" Default="yes" Cancel="yes" Text="Aceptar">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>

      <!--
        Inserta SqlServerDlg entre InstallDirDlg y VerifyReadyDlg.
        WixUI_InstallDir ya define, para "InstallDirDlg"/"Next", sus propios eventos
        internos con Order 1 a 4 (fijar target path, validar el path elegido, mostrar
        InvalidDirDlg si es inválido y, en Order="4", saltar a VerifyReadyDlg si el
        path es válido). Para insertar nuestro diálogo hay que agregar un evento
        adicional con Order MAYOR al 4 del wizard base y la MISMA condición de éxito
        (WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"); al procesarse en orden
        ascendente, el NewDialog de Order="4" del wizard base primero navega a
        VerifyReadyDlg, y el nuestro (Order="5", misma condición) lo pisa
        inmediatamente después navegando a SqlServerDlg, que es lo que termina viendo
        el usuario. Si en cambio se usa un Order bajo (p. ej. 2) con condición "1"
        siempre verdadera, como estaba antes, el evento compite con la validación del
        path del wizard base y el diálogo custom puede terminar sin mostrarse nunca.
        Mismo criterio para el botón "Back" de VerifyReadyDlg, que WixUI_InstallDir
        también publica por su cuenta hacia InstallDirDlg.
      -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="SqlServerDlg" Order="5">
        <![CDATA[WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"]]>
      </Publish>
      <Publish Dialog="SqlServerDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="SqlServerDlg" Order="2">1</Publish>
    </UI>

  </Product>
</Wix>
